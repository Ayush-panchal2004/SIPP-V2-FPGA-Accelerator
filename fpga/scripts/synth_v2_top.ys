# ============================================================
# synth_v2_top.ys
# Yosys Synthesis Script for SIPP V2.1 (Xilinx Artix-7 target)
# ============================================================

# Read all SystemVerilog RTL files
read_verilog -sv rtl/fp32_pkg.sv
read_verilog -sv rtl/sipp_fp32_mac.sv
read_verilog -sv rtl/sipp_adder_tree.sv
read_verilog -sv rtl/sipp_v2_top.sv

# Check design hierarchy
hierarchy -check -top sipp_v2_top

# Synthesize for Xilinx FPGA architecture (Artix-7)
# This will map logic to Xilinx LUTs, FFs, and DSPs
synth_xilinx -top sipp_v2_top

# Print Area (Utilization) Statistics
stat
